{
  "$schema": "../gen/schemas/desktop-schema.json",
  "productName": "论文原始数据归档平台",
  "version": "0.4.0",
  "identifier": "com.deviljian.paperarchive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "论文原始数据归档平台",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "本地科研论文与原始数据归档工具",
    "longDescription": "用于管理论文、Figure、Panel、Table 和科研原始文件的 Windows 本地归档平台。"
  }
}
