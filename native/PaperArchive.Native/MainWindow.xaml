<Window
    x:Class="PaperArchive.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="论文原始数据">
    <Grid Background="#FFFFFF" RequestedTheme="Light" RowSpacing="0">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="Open_Invoked"/>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked"/>
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="Undo_Invoked"/>
            <KeyboardAccelerator Key="F2" Invoked="Rename_Invoked"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="29"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#F5F8FC" Padding="18,0" ColumnSpacing="12"
              BorderBrush="#D9E2EA" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="论文原始数据" FontWeight="SemiBold"
                       FontSize="18" Foreground="#182B3B" VerticalAlignment="Center" Margin="0,0,18,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3"
                        VerticalAlignment="Center">
                <Button x:Name="ProcessTab" Content="论文归档" Click="ProcessTab_Click"/>
                <Button x:Name="LibraryTab" Content="论文资源库" Click="LibraryTab_Click"/>
            </StackPanel>
            <TextBlock Grid.Column="3" Text="WinUI 3" Foreground="#475569"
                       VerticalAlignment="Center" FontSize="12"/>
        </Grid>

        <Grid Grid.Row="1" Background="#FAFBFD" Padding="13,9" ColumnSpacing="9"
              BorderBrush="#D9E2EA" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenButton" Grid.Column="0" Content="打开文件夹" Click="OpenButton_Click"/>
            <Button x:Name="RoleButton" Grid.Column="1" Content="批量分类" Click="RoleButton_Click"/>
            <Button x:Name="RenameButton" Grid.Column="2" Content="批量编号" Click="RenameButton_Click"/>
            <Button x:Name="ImportButton" Grid.Column="3" Content="完成归档" Click="ImportButton_Click"/>
            <TextBox x:Name="SearchBox" Grid.Column="5" PlaceholderText="搜索文件"
                     TextChanged="SearchBox_TextChanged" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Background="#F8FAFC" RowSpacing="8" Padding="12"
                  BorderBrush="#D9E2EA" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="SidebarTitle" Text="目录" FontSize="15" Foreground="#1F2937" FontWeight="SemiBold"/>
                <ListView x:Name="FolderList" Grid.Row="1" FontSize="14" Foreground="#1F2937" Background="#FFFFFF" SelectionMode="Single"
                          SelectionChanged="FolderList_SelectionChanged"/>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="12,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="86"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="文件 / 资源" VerticalAlignment="Center" FontSize="12" Foreground="#43546A"/>
                    <TextBlock Grid.Column="1" Text="Figure" VerticalAlignment="Center" FontSize="12" Foreground="#43546A"/>
                    <TextBlock Grid.Column="2" Text="类型" VerticalAlignment="Center" FontSize="12" Foreground="#43546A"/>
                    <TextBlock Grid.Column="3" Text="大小" VerticalAlignment="Center" FontSize="12" Foreground="#43546A"/>
                </Grid>
                <ListView Grid.Row="1" x:Name="FileList" Foreground="#1F2937" Background="#FFFFFF" SelectionMode="Multiple"
                          SelectionChanged="FileList_SelectionChanged">
                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="批量分类" Click="RoleButton_Click"/>
                            <MenuFlyoutItem Text="批量编号" Click="RenameButton_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="撤销" Click="Undo_Click"/>
                            <MenuFlyoutItem Text="打开原始文件" Click="RevealButton_Click"/>
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="86"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" Foreground="#1C2B3A" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="14"/>
                                    <TextBlock Text="{Binding Directory}" Foreground="#526277" TextTrimming="CharacterEllipsis"
                                               FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding FigureLabel}" Foreground="#273D52"
                                           VerticalAlignment="Center" FontSize="13"/>
                                <TextBlock Grid.Column="2" Text="{Binding RoleLabel}" Foreground="#273D52"
                                           VerticalAlignment="Center" FontSize="13"/>
                                <TextBlock Grid.Column="3" Text="{Binding SizeLabel}" Foreground="#475569"
                                           VerticalAlignment="Center" FontSize="13"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="2" Background="#F8FAFC" Padding="16" RowSpacing="10"
                  BorderBrush="#D9E2EA" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="27"/>
                    <RowDefinition Height="210"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="检查器" FontSize="15" Foreground="#1F2937" FontWeight="SemiBold"/>
                <Border Grid.Row="1" Background="#EEF2F7"
                        CornerRadius="7">
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="6"/>
                </Border>
                <TextBlock x:Name="DetailName" Grid.Row="2" FontWeight="SemiBold"
                           Foreground="#182B3B" TextWrapping="WrapWholeWords" FontSize="14"/>
                <TextBlock x:Name="DetailMeta" Grid.Row="3" FontSize="13" Foreground="#41566B"
                           TextWrapping="WrapWholeWords"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" Background="#EEF2F7"
              Padding="13,0">
            <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center" Foreground="#334155"
                       FontSize="12"/>
        </Grid>
    </Grid>
</Window>
