<Window x:Class="PaperArchive.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PaperArchive · 论文原始数据管理平台" Width="1440" Height="900"
        MinWidth="990" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}" FontFamily="Segoe UI"
        FontSize="12" KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="49"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="29"/>
        </Grid.RowDefinitions>
        <!-- Native desktop navigation, not a dashboard -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <TextBlock DockPanel.Dock="Left" Text="PaperArchive" FontSize="15"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <RadioButton x:Name="WorkspaceTab" Content="归档前工作台" GroupName="MainTabs"
                                 IsChecked="True" Checked="MainTab_Changed"
                                 VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <RadioButton x:Name="LibraryTab" Content="论文资源库" GroupName="MainTabs"
                                 Checked="MainTab_Changed" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="WarehouseLabel" Text="本地数据仓库"
                           Foreground="#666666" HorizontalAlignment="Right"
                           VerticalAlignment="Center" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
        <!-- File Explorer style: creation/import/export menus are separate
             from selection-specific commands. -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="13,4" LastChildFill="False">
                <StackPanel x:Name="WorkflowMenus" DockPanel.Dock="Left" Orientation="Horizontal">
                    <Menu Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                        <MenuItem Header="新建 ▾" Padding="14,5">
                            <MenuItem x:Name="CreatePaperButton" Header="论文项目" Click="CreatePaper_Click"/>
                            <MenuItem x:Name="CreateProjectButton" Header="实验项目" Click="CreateProject_Click"/>
                            <MenuItem x:Name="CreateResultButton" Header="实验结果单元" Click="CreateResult_Click"/>
                            <Separator/>
                            <MenuItem Header="Figure / Panel…" Click="FigureTemplate_Click"/>
                        </MenuItem>
                        <MenuItem Header="导入 ▾" Padding="14,5">
                            <MenuItem x:Name="ImportButton" Header="单个实验结果…" Click="Import_Click"/>
                            <MenuItem x:Name="ImportProjectButton" Header="完整实验项目（待整理）…" Click="ImportProject_Click"/>
                            <MenuItem Header="论文文档…" IsEnabled="False" ToolTip="随论文归档阅读器实现"/>
                        </MenuItem>
                        <MenuItem Header="导出 ▾" Padding="14,5">
                            <MenuItem x:Name="ExportButton" Header="原始文件…" Click="ExportOriginal_Click"/>
                            <MenuItem Header="当前结果文件夹…" Click="ExportResultFolder_Click"/>
                            <MenuItem x:Name="FigureButton" Header="用于组图…" Click="Figure_Click"/>
                            <Separator/>
                            <MenuItem Header="论文归档包…" IsEnabled="False"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="292"
                         VerticalContentAlignment="Center" ToolTip="在当前选中项目范围中搜索"
                         TextChanged="Search_Changed"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Background="#FFFAFAFA" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="12,5" LastChildFill="False">
                <StackPanel x:Name="FileCommands" DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="剪切" ToolTip="Ctrl+X" Click="CutAssets_Click"/>
                    <Button x:Name="CopyButton" Content="复制" Click="Copy_Click"/>
                    <Button Content="粘贴" ToolTip="Ctrl+V" Click="PasteAssets_Click"/>
                    <Button Content="重命名" ToolTip="F2" Click="RenameSelected_Click"/>
                    <Button Content="删除" ToolTip="Delete" Click="DeleteAssets_Click"/>
                    <Button x:Name="MoveButton" Content="移动到 ▾" Click="MoveSelected_Click"/>
                    <Separator Margin="5,4" Width="1" Background="#FFDEDEDE"/>
                    <Button Content="排序 ▾" Click="SortMenu_Click"/>
                    <Button Content="查看 ▾" Click="ViewMenu_Click"/>
                    <Button Content="更多 ▾" Click="MoreMenu_Click"/>
                </StackPanel>
                <Button x:Name="ConfirmUsageButton" DockPanel.Dock="Right"
                        Content="确认用于论文" Click="ConfirmUsage_Click"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="3" x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="350"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition x:Name="DetailsColumn" Width="280" MinWidth="200"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FFFBFBFB" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="100"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="236" MinHeight="125"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SidebarHeading" Text="论文项目" FontWeight="SemiBold"
                               Margin="12,12,0,9" Foreground="#FF404040"/>
                    <TreeView Grid.Row="1" x:Name="ProjectTree" Margin="5,0,5,4"
                              Background="Transparent" BorderThickness="0"
                              AllowDrop="True"
                              PreviewMouseRightButtonDown="ProjectTree_PreviewMouseRightButtonDown"
                              ContextMenuOpening="ProjectTree_ContextMenuOpening"
                              PreviewDragOver="ProjectTree_PreviewDragOver"
                              PreviewDrop="ProjectTree_PreviewDrop"
                              DragLeave="ProjectTree_DragLeave"
                              SelectedItemChanged="ProjectTree_SelectedItemChanged">
                        <TreeView.Resources>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="MinHeight" Value="31"/>
                                <Setter Property="Padding" Value="5,4,5,4"/>
                                <Setter Property="Foreground" Value="#FF282828"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FFE5F1FE"/>
                                        <Setter Property="Foreground" Value="#FF005FB8"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF0F3F7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.Resources>
                    </TreeView>
                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                  Background="#FFE6E6E6" ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"/>
                    <TextBlock Grid.Row="3" Text="浏览位置" FontWeight="SemiBold"
                               Margin="12,11,0,8" Foreground="#FF555555"/>
                    <ListBox Grid.Row="4" x:Name="FolderList" Margin="5,0,5,4"
                             Background="Transparent" BorderThickness="0"
                             SelectionChanged="FolderList_SelectionChanged"
                             ContextMenuOpening="FolderList_ContextMenuOpening"/>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#FFEDEDED" ResizeBehavior="PreviousAndNext"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#FFFAFAFA" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                    <DockPanel Margin="12,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                    VerticalAlignment="Center">
                            <Button Content="详细信息" Click="DetailsView_Click"/>
                            <Button Content="大图标" Click="ThumbnailsView_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="CurrentLocation" VerticalAlignment="Center"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Text="选择实验项目"/>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1">
                    <ListView x:Name="FileList" SelectionMode="Extended"
                              SelectionChanged="AssetSelection_Changed"
                              MouseDoubleClick="Files_DoubleClick"
                              PreviewMouseLeftButtonDown="Files_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="Files_PreviewMouseMove"
                              PreviewMouseRightButtonDown="Files_PreviewMouseRightButtonDown"
                              ContextMenuOpening="Files_ContextMenuOpening"
                              Background="White" BorderThickness="0">
                        <ListView.Resources>
                            <Style TargetType="{x:Type GridViewColumnHeader}">
                                <EventSetter Event="Click" Handler="ColumnHeader_Click"/>
                                <EventSetter Event="ContextMenuOpening" Handler="ColumnHeader_ContextMenuOpening"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value><ContextMenu/></Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" Width="230" DisplayMemberBinding="{Binding FileName}"/>
                                <GridViewColumn Header="阶段" Width="94" DisplayMemberBinding="{Binding StageLabel}"/>
                                <GridViewColumn Header="数据组" Width="112" DisplayMemberBinding="{Binding GroupPrefix}"/>
                                <GridViewColumn Header="所属实验结果" Width="155" DisplayMemberBinding="{Binding ResultLabel}"/>
                                <GridViewColumn Header="所在目录" Width="240" DisplayMemberBinding="{Binding DirectoryLabel}"/>
                                <GridViewColumn Header="大小" Width="92" DisplayMemberBinding="{Binding SizeLabel}"/>
                                <GridViewColumn Header="论文位置" Width="130" DisplayMemberBinding="{Binding UsageLabel}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <ListBox x:Name="ThumbnailList" Visibility="Collapsed" Background="White"
                             SelectionMode="Extended" BorderThickness="0"
                             SelectionChanged="AssetSelection_Changed"
                             MouseDoubleClick="Files_DoubleClick"
                             PreviewMouseLeftButtonDown="Files_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="Files_PreviewMouseMove"
                             ContextMenuOpening="Files_ContextMenuOpening"
                             PreviewMouseRightButtonDown="Files_PreviewMouseRightButtonDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="160" Height="150" Margin="8">
                                    <Border Height="112" BorderBrush="#FFE1E1E1" BorderThickness="1" Background="#FFF5F5F5">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4"/>
                                    </Border>
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center" MaxWidth="150" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding StageLabel}" Foreground="#FF666666"
                                               HorizontalAlignment="Center" FontSize="10"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid x:Name="LibraryArea" Visibility="Collapsed" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="已归档论文资源" FontSize="15" FontWeight="SemiBold"
                                   Margin="16,13,0,0"/>
                        <ListView x:Name="LibraryFiles" Grid.Row="1" BorderThickness="0"
                                  SelectionChanged="LibraryFiles_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="文件名" Width="270" DisplayMemberBinding="{Binding FileName}"/>
                                    <GridViewColumn Header="所属 Figure / Panel" Width="210" DisplayMemberBinding="{Binding Group}"/>
                                    <GridViewColumn Header="角色" Width="130" DisplayMemberBinding="{Binding Role}"/>
                                    <GridViewColumn Header="大小" Width="110" DisplayMemberBinding="{Binding Size}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Grid>
            </Grid>
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Left"
                          Background="#FFEDEDED" ResizeBehavior="PreviousAndNext" x:Name="DetailSplitter"/>
            <Button Grid.Column="3" x:Name="DetailsChevron" Content="‹"
                    Width="13" Height="46" Padding="0" Margin="0"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="#FFF4F4F4" BorderBrush="#FFD5D5D5"
                    BorderThickness="1" ToolTip="折叠 / 展开详细信息 (Alt+Shift+P)"
                    Click="Details_Click" Panel.ZIndex="2"/>
            <Border x:Name="DetailsPane" Grid.Column="4" Background="White"
                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,14">
                        <TextBlock Text="详细信息" FontWeight="SemiBold" FontSize="14"/>
                        <Border Height="195" Background="#FFF7F7F7" BorderBrush="#FFE5E5E5"
                                BorderThickness="1" Margin="0,14,0,8">
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="6"/>
                        </Border>
                        <TextBlock x:Name="DetailName" Text="未选择文件"
                                   FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,9"/>
                        <TextBlock x:Name="DetailMeta" Foreground="#FF555555"
                                   TextWrapping="Wrap" LineHeight="23"/>
                        <Separator Margin="0,17,0,12"/>
                        <TextBlock Text="同组文件" FontWeight="SemiBold" Margin="0,0,0,9"/>
                        <ItemsControl x:Name="RelatedFiles">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Separator Margin="0,12,0,12"/>
                        <TextBlock Text="论文用途" FontWeight="SemiBold" Margin="0,0,0,9"/>
                        <ItemsControl x:Name="UsageList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Margin="0,0,0,8" TextWrapping="Wrap"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Text="当前位置  |  显示 0 / 共 0 个文件  |  已选 0 项"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>