<Window x:Class="PaperArchive.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PaperArchive · 论文原始数据管理平台" Width="1440" Height="900"
        MinWidth="990" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}" FontFamily="Segoe UI"
        FontSize="12" KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="49"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="29"/>
        </Grid.RowDefinitions>
        <!-- Native desktop navigation, not a dashboard -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <TextBlock DockPanel.Dock="Left" Text="PaperArchive" FontSize="15"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <RadioButton x:Name="WorkspaceTab" Content="归档前工作台" GroupName="MainTabs"
                                 IsChecked="True" Checked="MainTab_Changed"
                                 VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <RadioButton x:Name="LibraryTab" Content="论文资源库" GroupName="MainTabs"
                                 Checked="MainTab_Changed" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="WarehouseLabel" Text="本地数据仓库"
                           Foreground="#666666" HorizontalAlignment="Right"
                           VerticalAlignment="Center" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
        <!-- File Explorer style: creation/import/export menus are separate
             from selection-specific commands. -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="13,4" LastChildFill="False">
                <StackPanel x:Name="WorkflowMenus" DockPanel.Dock="Left" Orientation="Horizontal">
                    <Menu Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                        <MenuItem Header="新建 ▾" Padding="14,5">
                            <MenuItem x:Name="CreatePaperButton" Header="论文项目" Click="CreatePaper_Click"/>
                            <MenuItem x:Name="CreateProjectButton" Header="实验项目" Click="CreateProject_Click"/>
                            <MenuItem x:Name="CreateResultButton" Header="实验结果单元" Click="CreateResult_Click"/>
                            <Separator/>
                            <MenuItem Header="Figure / Panel…" Click="FigureTemplate_Click"/>
                        </MenuItem>
                        <MenuItem Header="导入 ▾" Padding="14,5">
                            <MenuItem x:Name="ImportButton" Header="单个实验结果…" Click="Import_Click"/>
                            <MenuItem x:Name="ImportProjectButton" Header="完整实验项目（待整理）…" Click="ImportProject_Click"/>
                            <MenuItem Header="论文文档（PDF / Word）…" Click="ImportPaperDocument_Click"/>
                        </MenuItem>
                        <MenuItem Header="导出 ▾" Padding="14,5">
                            <MenuItem x:Name="ExportButton" Header="原始文件…" Click="ExportOriginal_Click"/>
                            <MenuItem Header="当前结果文件夹…" Click="ExportResultFolder_Click"/>
                            <MenuItem x:Name="FigureButton" Header="用于组图…" Click="Figure_Click"/>
                            <Separator/>
                            <MenuItem Header="论文归档包…" IsEnabled="False"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
                <Button x:Name="ArchivePaperButton" DockPanel.Dock="Right"
                        Content="归档到论文资源库…" Margin="14,0,0,0"
                        Click="ArchivePaper_Click"/>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="292"
                         VerticalContentAlignment="Center" ToolTip="在当前选中项目范围中搜索"
                         TextChanged="Search_Changed"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Background="#FFFAFAFA" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="12,5" LastChildFill="False">
                <TextBlock x:Name="PaperHomeToolbarHint" DockPanel.Dock="Left"
                           Visibility="Collapsed" VerticalAlignment="Center"
                           Foreground="#FF666666"
                           Text="论文任务概览 · 只处理待办事项；关联和索引会随操作自动更新"/>
                <StackPanel x:Name="FileCommands" DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="剪切" ToolTip="Ctrl+X" Click="CutAssets_Click"/>
                    <Button x:Name="CopyButton" Content="复制" Click="Copy_Click"/>
                    <Button Content="粘贴" ToolTip="Ctrl+V" Click="PasteAssets_Click"/>
                    <Button Content="重命名" ToolTip="F2" Click="RenameSelected_Click"/>
                    <Button Content="删除" ToolTip="Delete" Click="DeleteAssets_Click"/>
                    <Button x:Name="MoveButton" Content="移动到 ▾" Click="MoveSelected_Click"/>
                    <Separator Margin="5,4" Width="1" Background="#FFDEDEDE"/>
                    <Button Content="排序 ▾" Click="SortMenu_Click"/>
                    <Button Content="查看 ▾" Click="ViewMenu_Click"/>
                    <Button Content="更多 ▾" Click="MoreMenu_Click"/>
                </StackPanel>
                <Button x:Name="ConfirmUsageButton" DockPanel.Dock="Right"
                        Content="确认用于论文" Click="ConfirmUsage_Click"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="3" x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="350"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition x:Name="DetailsColumn" Width="280" MinWidth="200"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FFFBFBFB" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="100"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="236" MinHeight="125"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SidebarHeading" Text="论文项目" FontWeight="SemiBold"
                               Margin="12,12,0,9" Foreground="#FF404040"/>
                    <TreeView Grid.Row="1" x:Name="ProjectTree" Margin="5,0,5,4"
                              Background="Transparent" BorderThickness="0"
                              AllowDrop="True"
                              PreviewMouseRightButtonDown="ProjectTree_PreviewMouseRightButtonDown"
                              ContextMenuOpening="ProjectTree_ContextMenuOpening"
                              PreviewDragOver="ProjectTree_PreviewDragOver"
                              PreviewDrop="ProjectTree_PreviewDrop"
                              DragLeave="ProjectTree_DragLeave"
                              SelectedItemChanged="ProjectTree_SelectedItemChanged">
                        <TreeView.Resources>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="Foreground" Value="#FF222222"/>
                                <Setter Property="MinHeight" Value="31"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border x:Name="RowBorder" Background="Transparent"
                                                        CornerRadius="4" Margin="3,1" MinHeight="30">
                                                    <DockPanel LastChildFill="True">
                                                        <ToggleButton x:Name="Expander" DockPanel.Dock="Left"
                                                                      Width="19" Margin="0,0,2,0" Padding="0"
                                                                      Background="Transparent" BorderThickness="0"
                                                                      Focusable="False"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                                    <Grid Background="Transparent" Width="19" Height="26">
                                                                        <Path x:Name="ArrowPath" Stroke="#FF555555"
                                                                              StrokeThickness="1.5"
                                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                              Data="M 5,3 L 9,7 L 5,11" Width="16" Height="16"
                                                                              Stretch="None" HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="ArrowPath" Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <RotateTransform Angle="90" CenterX="7" CenterY="7"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter ContentSource="Header"
                                                                          VerticalAlignment="Center" Margin="2,3,4,3"/>
                                                    </DockPanel>
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="17,0,0,0"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                </Trigger>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="#FFF0F4F8"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="#FFE4F0FC"/>
                                                    <Setter Property="Foreground" Value="#FF202020"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.Resources>
                    </TreeView>
                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                  Background="#FFE6E6E6" ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"/>
                    <!-- The filter heading and options share one resizable pane. -->
                    <Grid Grid.Row="3" x:Name="FilterPane" MinHeight="125">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="FilterHeading" Grid.Row="0" Text="文件筛选"
                                   FontWeight="SemiBold" Margin="12,11,0,8"
                                   Foreground="#FF555555"/>
                        <ListBox Grid.Row="1" x:Name="FolderList" Margin="5,0,5,4"
                                 VerticalAlignment="Stretch"
                                 Background="Transparent" BorderThickness="0"
                                 SelectionChanged="FolderList_SelectionChanged"
                                 ContextMenuOpening="FolderList_ContextMenuOpening"/>
                    </Grid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#FFEDEDED" ResizeBehavior="PreviousAndNext"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#FFFAFAFA" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                    <DockPanel Margin="12,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                    VerticalAlignment="Center">
                            <Button Content="详细信息" Click="DetailsView_Click"/>
                            <Button Content="大图标" Click="ThumbnailsView_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="CurrentLocation" VerticalAlignment="Center"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Text="选择实验项目"/>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1">
                    <ListView x:Name="FileList" SelectionMode="Extended"
                              SelectionChanged="AssetSelection_Changed"
                              MouseDoubleClick="Files_DoubleClick"
                              PreviewMouseLeftButtonDown="Files_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="Files_PreviewMouseMove"
                              PreviewMouseRightButtonDown="Files_PreviewMouseRightButtonDown"
                              ContextMenuOpening="Files_ContextMenuOpening"
                              Background="White" BorderThickness="0">
                        <ListView.Resources>
                            <Style TargetType="{x:Type GridViewColumnHeader}">
                                <EventSetter Event="Click" Handler="ColumnHeader_Click"/>
                                <EventSetter Event="ContextMenuOpening" Handler="ColumnHeader_ContextMenuOpening"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value><ContextMenu/></Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" Width="230" DisplayMemberBinding="{Binding FileName}"/>
                                <GridViewColumn Header="阶段" Width="94" DisplayMemberBinding="{Binding StageLabel}"/>
                                <GridViewColumn Header="数据组" Width="112" DisplayMemberBinding="{Binding GroupPrefix}"/>
                                <GridViewColumn Header="所属实验结果" Width="155" DisplayMemberBinding="{Binding ResultLabel}"/>
                                <GridViewColumn Header="所在目录" Width="240" DisplayMemberBinding="{Binding DirectoryLabel}"/>
                                <GridViewColumn Header="大小" Width="92" DisplayMemberBinding="{Binding SizeLabel}"/>
                                <GridViewColumn Header="论文位置" Width="130" DisplayMemberBinding="{Binding UsageLabel}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <ListBox x:Name="ThumbnailList" Visibility="Collapsed" Background="White"
                             SelectionMode="Extended" BorderThickness="0"
                             SelectionChanged="AssetSelection_Changed"
                             MouseDoubleClick="Files_DoubleClick"
                             PreviewMouseLeftButtonDown="Files_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="Files_PreviewMouseMove"
                             ContextMenuOpening="Files_ContextMenuOpening"
                             PreviewMouseRightButtonDown="Files_PreviewMouseRightButtonDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="160" Height="150" Margin="8">
                                    <Border Height="112" BorderBrush="#FFE1E1E1" BorderThickness="1" Background="#FFF5F5F5">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4"/>
                                    </Border>
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center" MaxWidth="150" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding StageLabel}" Foreground="#FF666666"
                                               HorizontalAlignment="Center" FontSize="10"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- V1.6 task-driven paper home, shown when the paper root is selected. -->
                    <ScrollViewer x:Name="PaperHomeArea" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Background="White">
                        <StackPanel Margin="24,18,24,20" MaxWidth="1020"
                                    HorizontalAlignment="Stretch">
                            <TextBlock x:Name="PaperHomeTitle" FontSize="19"
                                       FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="PaperHomeStatus" FontSize="13"
                                       Foreground="#FF385E7E" Margin="0,0,0,16"/>
                            <Border BorderBrush="#FFE1E7EC" BorderThickness="1"
                                    Background="#FFF9FBFD" Padding="16,12"
                                    Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="项目进度" FontWeight="SemiBold"
                                               FontSize="13" Margin="0,0,0,9"/>
                                    <TextBlock x:Name="PaperHomeProgress" LineHeight="24"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="PaperHomePrimary" Foreground="#FF555555"
                                               TextWrapping="Wrap" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                            <DockPanel LastChildFill="False" Margin="0,0,0,14">
                                <TextBlock Text="需要处理" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <Button DockPanel.Dock="Right" Content="更新检查"
                                        Click="PaperHomeRefresh_Click"/>
                            </DockPanel>
                            <ItemsControl x:Name="PaperHomeTasks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FFE6E6E6" BorderThickness="0,0,0,1"
                                                Padding="7,12">
                                            <DockPanel LastChildFill="True">
                                                <Button Content="{Binding ActionLabel}"
                                                        Tag="{Binding}" Click="PaperHomeTask_Click"
                                                        DockPanel.Dock="Right" MinWidth="82"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               Margin="0,5,0,0"
                                                               TextWrapping="Wrap"
                                                               Foreground="#FF666666"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="PaperHomeEmpty" Visibility="Collapsed"
                                       Text="没有必须处理的事项。可以继续编辑，或直接归档。"
                                       Foreground="#FF47775B" Margin="6,12,0,20"/>
                            <WrapPanel Margin="0,20,0,0">
                                <Button Content="导入实验数据" Click="PaperHomeImportExperiment_Click"
                                        Margin="0,0,10,8"/>
                                <Button Content="导入全文" Click="PaperHomeImportDocument_Click"
                                        Margin="0,0,10,8"/>
                                <Button Content="进入组图" Click="PaperHomeFigures_Click"
                                        Margin="0,0,10,8"/>
                                <Button Content="论文关联" Click="PaperHomeDocuments_Click"
                                        Margin="0,0,10,8"/>
                                <Button x:Name="PaperHomeArchiveAction" Content="归档论文…"
                                        Click="ArchivePaper_Click"
                                        Margin="10,0,0,8" MinWidth="115"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Figure workspace; placeholder rows are not image files. -->
                    <Grid x:Name="FigureArea" Visibility="Collapsed" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="196"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#FFF9F9F9" BorderBrush="#FFE4E4E4" BorderThickness="0,0,0,1">
                            <DockPanel Margin="10,7" LastChildFill="False">
                                <StackPanel Orientation="Horizontal" x:Name="FigureCommands" DockPanel.Dock="Left">
                                    <Button x:Name="QuickFigureButton" Content="+ Figure"
                                            Click="QuickFigure_Click"/>
                                    <Button x:Name="QuickPanelButton" Content="+ Panel"
                                            Click="QuickPanel_Click"/>
                                    <Button x:Name="BatchFigureButton" Content="批量 Figure…"
                                            Click="BatchFigure_Click"/>
                                    <Button x:Name="BatchPanelButton" Content="批量 Panel…"
                                            Click="BatchPanel_Click"/>
                                    <Button Content="关联 SHOW…" Click="LinkShowFromFigure_Click"/>
                                    <Button Content="导出全部素材…" Click="ExportFigureMaterials_Click"/>
                                    <Button Content="导入完整 Figure…" Click="ImportComposite_Click"/>
                                    <Button Content="导出完整 Figure…" Click="ExportComposite_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Background="#FFFBFBFB"
                                BorderBrush="#FFE5E5E5" BorderThickness="0,0,0,1">
                            <DockPanel Margin="14,10">
                                <StackPanel DockPanel.Dock="Right" Width="250"
                                            Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="FigureHeroTitle" Text="Figure 版本预览"
                                               FontWeight="SemiBold" FontSize="14"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="FigureHeroDescription"
                                               Text="选中 Figure、Panel 或完整成图，预览将显示在这里。"
                                               Foreground="#FF666666" Margin="0,9,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Background="White" BorderBrush="#FFE5E5E5"
                                        BorderThickness="1" CornerRadius="5">
                                    <Image x:Name="FigureHeroImage" Stretch="Uniform" Margin="5"/>
                                </Border>
                            </DockPanel>
                        </Border>
                        <ListView x:Name="FigureFiles" Grid.Row="2" BorderThickness="0"
                                  SelectionMode="Extended"
                                  SelectionChanged="FigureFiles_SelectionChanged"
                                  MouseDoubleClick="FigureFiles_DoubleClick"
                                  PreviewMouseRightButtonDown="FigureFiles_PreviewMouseRightButtonDown"
                                  ContextMenuOpening="FigureFiles_ContextMenuOpening">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="名称 / 预览" Width="295">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="52" Height="44" Margin="0,2,10,2"
                                                            BorderBrush="#FFE3E3E3" BorderThickness="1"
                                                            Background="#FFF7F7F7" CornerRadius="3">
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                               Margin="2"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               MaxWidth="210"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="类型" Width="130" DisplayMemberBinding="{Binding Type}"/>
                                    <GridViewColumn Header="数量" Width="90" DisplayMemberBinding="{Binding Count}"/>
                                    <GridViewColumn Header="状态" Width="170" DisplayMemberBinding="{Binding Status}"/>
                                    <GridViewColumn Header="详细信息" Width="240" DisplayMemberBinding="{Binding Detail}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                    <Grid x:Name="ManuscriptArea" Visibility="Collapsed" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="13,7">
                            <TextBlock Text="论文全文 · PDF / Word" FontSize="14"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="导入全文…" DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    Click="ImportPaperDocument_Click"/>
                            <Button Content="关联 Figure…" DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    Click="LinkManuscriptFigures_Click"/>
                            <Button Content="查看完整溯源…" DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    Click="ViewManuscriptProvenance_Click"/>
                        </DockPanel>
                        <ListView x:Name="ManuscriptList" Grid.Row="1" BorderThickness="0"
                                  MouseDoubleClick="Manuscript_DoubleClick"
                                  SelectionChanged="Manuscript_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="名称" Width="330" DisplayMemberBinding="{Binding FileName}"/>
                                    <GridViewColumn Header="大小（字节）" Width="130" DisplayMemberBinding="{Binding Size}"/>
                                    <GridViewColumn Header="导入时间" Width="215" DisplayMemberBinding="{Binding ImportedAt}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                    <Grid x:Name="LibraryArea" Visibility="Collapsed" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="13,7" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="已归档论文资源"
                                       FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="查看归档溯源 / 版本…"
                                    Click="ViewArchivedProvenance_Click"/>
                        </DockPanel>
                        <ListView x:Name="LibraryFiles" Grid.Row="1" BorderThickness="0"
                                  SelectionChanged="LibraryFiles_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="文件名" Width="270" DisplayMemberBinding="{Binding FileName}"/>
                                    <GridViewColumn Header="所属 Figure / Panel" Width="210" DisplayMemberBinding="{Binding Group}"/>
                                    <GridViewColumn Header="角色" Width="130" DisplayMemberBinding="{Binding Role}"/>
                                    <GridViewColumn Header="大小" Width="110" DisplayMemberBinding="{Binding Size}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Grid>
            </Grid>
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Left"
                          Background="#FFEDEDED" ResizeBehavior="PreviousAndNext" x:Name="DetailSplitter"/>
            <Button Grid.Column="3" x:Name="DetailsChevron" Content="‹"
                    Width="13" Height="46" Padding="0" Margin="0"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="#FFF4F4F4" BorderBrush="#FFD5D5D5"
                    BorderThickness="1" ToolTip="折叠 / 展开详细信息 (Alt+Shift+P)"
                    Click="Details_Click" Panel.ZIndex="2"/>
            <Border x:Name="DetailsPane" Grid.Column="4" Background="White"
                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,14">
                        <TextBlock Text="详细信息" FontWeight="SemiBold" FontSize="14"/>
                        <Border Height="195" Background="#FFF7F7F7" BorderBrush="#FFE5E5E5"
                                BorderThickness="1" Margin="0,14,0,8">
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="6"/>
                        </Border>
                        <TextBlock x:Name="DetailName" Text="未选择文件"
                                   FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,9"/>
                        <TextBlock x:Name="DetailMeta" Foreground="#FF555555"
                                   TextWrapping="Wrap" LineHeight="23"/>
                        <Separator Margin="0,17,0,12"/>
                        <TextBlock x:Name="RelatedHeading" Text="同组文件" FontWeight="SemiBold" Margin="0,0,0,9"/>
                        <ItemsControl x:Name="RelatedFiles">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="CompositeSourcesPanel" Visibility="Collapsed"
                                    Margin="0,6,0,12">
                            <TextBlock Text="本版本 Panel/SHOW 来源"
                                       FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="CompositeSourcesNotice"
                                       TextWrapping="Wrap" Foreground="#FF666666"
                                       Margin="0,0,0,10"/>
                            <ItemsControl x:Name="CompositeSourceCards">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                            <Border DockPanel.Dock="Left" Width="64" Height="54"
                                                    Margin="0,0,9,0" Background="#FFF7F7F7"
                                                    BorderBrush="#FFE5E5E5" BorderThickness="1">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                                                           Foreground="#FF666666" FontSize="11"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="ConfirmCompositeSourceButton"
                                    Content="核对并确认本版本来源"
                                    HorizontalAlignment="Stretch" Margin="0,5,0,0"
                                    Click="ConfirmCompositeSources_Click"/>
                        </StackPanel>
                        <Separator Margin="0,12,0,12"/>
                        <TextBlock x:Name="UsageHeading" Text="论文用途" FontWeight="SemiBold" Margin="0,0,0,9"/>
                        <ItemsControl x:Name="UsageList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Margin="0,0,0,8" TextWrapping="Wrap"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Text="当前位置  |  显示 0 / 共 0 个文件  |  已选 0 项"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>