<Window x:Class="PaperArchive.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PaperArchive · 论文原始数据管理平台" Width="1440" Height="900"
        MinWidth="990" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}" FontFamily="Segoe UI"
        FontSize="12" KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="49"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="29"/>
        </Grid.RowDefinitions>
        <!-- Native desktop navigation, not a dashboard -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <TextBlock DockPanel.Dock="Left" Text="PaperArchive" FontSize="15"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <RadioButton x:Name="WorkspaceTab" Content="归档前工作台" GroupName="MainTabs"
                                 IsChecked="True" Checked="MainTab_Changed"
                                 VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <RadioButton x:Name="LibraryTab" Content="论文资源库" GroupName="MainTabs"
                                 Checked="MainTab_Changed" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="WarehouseLabel" Text="本地数据仓库"
                           Foreground="#666666" HorizontalAlignment="Right"
                           VerticalAlignment="Center" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
            <DockPanel Margin="14,8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="CreateProjectButton" Content="新建实验项目" Click="CreateProject_Click"/>
                    <Button x:Name="ImportButton" Content="导入实验结果…" Click="Import_Click"/>
                    <Button x:Name="CopyButton" Content="复制" Click="Copy_Click"/>
                    <Button x:Name="ExportButton" Content="导出原图…" Click="ExportOriginal_Click"/>
                    <Button x:Name="FigureButton" Content="导出用于组图…" Click="Figure_Click"/>
                    <Button x:Name="ConfirmUsageButton" Content="确认用于论文" Click="ConfirmUsage_Click"/>
                    <Button x:Name="DetailsButton" Content="隐藏详细信息" Click="Details_Click"/>
                </StackPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="290"
                         VerticalContentAlignment="Center" ToolTip="搜索文件名称、路径或数据组"
                         TextChanged="Search_Changed"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2" x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="350"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition x:Name="DetailsColumn" Width="280" MinWidth="200"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SidebarHeading" Text="实验项目" FontWeight="SemiBold" Margin="14,13,0,10"/>
                    <TreeView Grid.Row="1" x:Name="ProjectTree" Margin="8,0,8,4"
                              BorderThickness="0" SelectedItemChanged="ProjectTree_SelectedItemChanged"/>
                    <TextBlock Grid.Row="2" Text="浏览位置" FontWeight="SemiBold" Margin="14,14,0,10"/>
                    <ListBox Grid.Row="3" x:Name="FolderList" Margin="7,0,7,8"
                             BorderThickness="0" SelectionChanged="FolderList_SelectionChanged"/>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#FFEDEDED" ResizeBehavior="PreviousAndNext"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#FFFAFAFA" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                    <DockPanel Margin="12,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                    VerticalAlignment="Center">
                            <Button Content="详细信息" Click="DetailsView_Click"/>
                            <Button Content="大图标" Click="ThumbnailsView_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="CurrentLocation" VerticalAlignment="Center"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Text="选择实验项目"/>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1">
                    <ListView x:Name="FileList" SelectionMode="Extended"
                              SelectionChanged="AssetSelection_Changed"
                              MouseDoubleClick="Files_DoubleClick"
                              Background="White" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" Width="230" DisplayMemberBinding="{Binding FileName}"/>
                                <GridViewColumn Header="阶段" Width="94" DisplayMemberBinding="{Binding StageLabel}"/>
                                <GridViewColumn Header="数据组" Width="112" DisplayMemberBinding="{Binding GroupPrefix}"/>
                                <GridViewColumn Header="所在目录" Width="240" DisplayMemberBinding="{Binding RelativePath}"/>
                                <GridViewColumn Header="大小" Width="92" DisplayMemberBinding="{Binding SizeLabel}"/>
                                <GridViewColumn Header="论文位置" Width="130" DisplayMemberBinding="{Binding UsageLabel}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <ListBox x:Name="ThumbnailList" Visibility="Collapsed" Background="White"
                             SelectionMode="Extended" BorderThickness="0"
                             SelectionChanged="AssetSelection_Changed"
                             MouseDoubleClick="Files_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="160" Height="150" Margin="8">
                                    <Border Height="112" BorderBrush="#FFE1E1E1" BorderThickness="1" Background="#FFF5F5F5">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4"/>
                                    </Border>
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center" MaxWidth="150" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding StageLabel}" Foreground="#FF666666"
                                               HorizontalAlignment="Center" FontSize="10"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid x:Name="LibraryArea" Visibility="Collapsed" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="已归档论文资源" FontSize="15" FontWeight="SemiBold"
                                   Margin="16,13,0,0"/>
                        <ListView x:Name="LibraryFiles" Grid.Row="1" BorderThickness="0"
                                  SelectionChanged="LibraryFiles_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="文件名" Width="270" DisplayMemberBinding="{Binding FileName}"/>
                                    <GridViewColumn Header="所属 Figure / Panel" Width="210" DisplayMemberBinding="{Binding Group}"/>
                                    <GridViewColumn Header="角色" Width="130" DisplayMemberBinding="{Binding Role}"/>
                                    <GridViewColumn Header="大小" Width="110" DisplayMemberBinding="{Binding Size}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Grid>
            </Grid>
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="#FFEDEDED" ResizeBehavior="PreviousAndNext" x:Name="DetailSplitter"/>
            <Border x:Name="DetailsPane" Grid.Column="4" Background="White"
                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,14">
                        <TextBlock Text="详细信息" FontWeight="SemiBold" FontSize="14"/>
                        <Border Height="195" Background="#FFF7F7F7" BorderBrush="#FFE5E5E5"
                                BorderThickness="1" Margin="0,14,0,8">
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="6"/>
                        </Border>
                        <TextBlock x:Name="DetailName" Text="未选择文件"
                                   FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,9"/>
                        <TextBlock x:Name="DetailMeta" Foreground="#FF555555"
                                   TextWrapping="Wrap" LineHeight="23"/>
                        <Separator Margin="0,17,0,12"/>
                        <TextBlock Text="同组文件" FontWeight="SemiBold" Margin="0,0,0,9"/>
                        <ItemsControl x:Name="RelatedFiles">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Separator Margin="0,12,0,12"/>
                        <TextBlock Text="论文用途" FontWeight="SemiBold" Margin="0,0,0,9"/>
                        <ItemsControl x:Name="UsageList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Margin="0,0,0,8" TextWrapping="Wrap"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Text="当前位置  |  显示 0 / 共 0 个文件  |  已选 0 项"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>