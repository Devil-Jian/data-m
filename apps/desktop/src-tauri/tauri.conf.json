{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Data-M",
  "version": "0.1.0",
  "identifier": "com.deviljian.datam",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5176",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
